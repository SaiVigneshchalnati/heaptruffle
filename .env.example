# HeapTruffle Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT put real secrets in this file — it is tracked by Git!

PORT=3000
NODE_ENV=development

# JWT Secret — used to sign authentication tokens
# REQUIRED: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here

# Gemini AI API Key (optional — enables AI-powered security reports)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS: restrict API to specific origin in production (leave unset in dev to allow all)
# CORS_ORIGIN=https://yourdomain.com

# Allow scanning with no authorized targets in the list (dangerous — keep false in production)
# ALLOW_OPEN_SCANNING=false